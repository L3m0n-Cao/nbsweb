{
  "name": "opennbs-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets": "node tools/extract-assets.mjs",
    "predev": "npm run assets",
    "dev": "vite --host 0.0.0.0",
    "build": "npm run assets && tsc --noEmit && vite build && node tools/build-offline.mjs",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:offline": "playwright test --config playwright.offline.config.ts",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": { "fflate": "^0.8.2", "@ffmpeg/ffmpeg": "^0.12.15", "@ffmpeg/core": "^0.12.10" },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^5.0.4"
  }
}
